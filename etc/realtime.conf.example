# weewx-clearskies-realtime configuration example
# Copy to /etc/weewx-clearskies/realtime.conf and edit as needed.
#
# SECRETS DO NOT BELONG HERE. Use /etc/weewx-clearskies/realtime-secrets.env
# (mode 0600) for MQTT credentials.
#
# Per ADR-027: any leaf key matching _(KEY|SECRET|TOKEN|PASSWORD) in this
# file will cause the service to refuse to start with a FATAL log message.
#
# Format: ConfigObj/INI. Section syntax [section], nested [[subsection]].


[input]
# Input mode. Only mqtt is implemented in v0.1.
mode = mqtt

    [[mqtt]]
    # MQTT broker host and port.
    broker_host = 127.0.0.1
    broker_port = 1883

    # Topic where weewx-mqtt publishes loop packets.
    topic = weewx/loop

    # MQTT client ID. Must be unique per broker.
    client_id = weewx-clearskies-realtime

    # MQTT username (leave empty for anonymous access).
    # username =

    # Name of the environment variable that holds the MQTT password.
    # The variable is read at startup from realtime-secrets.env.
    # Default: WEEWX_CLEARSKIES_MQTT_PASSWORD
    password_env = WEEWX_CLEARSKIES_MQTT_PASSWORD

    # TLS settings. Set tls = true for encrypted connections.
    # tls = false
    # ca_file =

    # MQTT QoS level (0, 1, or 2). Default 0 (at-most-once).
    # qos = 0

    # MQTT keepalive interval in seconds. Default 60.
    # keepalive = 60


[sse]
# SSE endpoint bind address.
# 0.0.0.0 = all IPv4 interfaces (default; reliable behind a reverse proxy).
# Do NOT use :: here: uvicorn sets IPV6_V6ONLY=1 on IPv6 sockets, so :: is
# IPv6-only regardless of the kernel net.ipv6.bindv6only setting.
# Use 127.0.0.1 for loopback-only (same-host topology).
bind_host = 0.0.0.0

# SSE endpoint port. Default 8766.
bind_port = 8766

# Allowed origins for CORS. Set to your dashboard domain in production.
# Use * during development only.
allowed_origins = https://weather.example.com


[health]
# Health endpoint bind address. Default loopback (not publicly exposed).
bind_host = 127.0.0.1

# Health endpoint port. Default 8082.
bind_port = 8082


[logging]
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# Override with CLEARSKIES_LOG_LEVEL env var.
level = INFO


[api]
# REQUIRED — upstream clearskies-api URL for BFF proxy mode (ADR-041).
#
# Caddy routes ALL /api/v1/* traffic to the realtime BFF (port 8766), which
# unit-converts responses before sending them to the dashboard.  The BFF must
# know where the upstream API lives.  If upstream_url is empty or missing,
# every /api/v1/* request returns 503 and THE WHOLE SITE FAILS.
#
# SINGLE-HOST (docker compose, single-host/): both services are compose
# services on the same host — use the compose service name as the hostname.
# upstream_url = https://api:8765
# tls_verify = false
#
# FRONTEND-HOST (docker compose, frontend-host/): realtime runs on the
# front-end host; the API runs on a separate weewx host.  Set to the weewx
# host's external or LAN address.
# upstream_url = https://weewx-host.example.com:8765
# tls_verify = false
#
# NATIVE / REVERSE-PROXY (pip-installed, both services on the same host):
# upstream_url = https://localhost:8765
# tls_verify = false
#
# tls_verify = false is correct for the default self-signed API certificate.
# Set to true only when the weewx host has a CA-signed certificate.
#
# Upstream request timeout in seconds.
# timeout = 30


[units]
# Operator display units for the BFF conversion layer (ADR-041 / ADR-042).
# When configured, all proxied REST responses and SSE events are converted
# to these units before delivery to the dashboard.
# Leave this section commented out to disable unit conversion.

    [[groups]]
    # Map each observation group to its display unit.
    # group_temperature = degree_F
    # group_speed = mile_per_hour
    # group_pressure = inHg
    # group_rain = inch
    # group_rainrate = inch_per_hour
    # group_altitude = foot
    # group_distance = mile

    [[labels]]
    # Override the default display label for a unit.
    # degree_F = " °F"
    # mile_per_hour = " mph"

    [[string_formats]]
    # Override the default printf-style format string for a unit.
    # degree_F = %.1f
    # inch = %.2f

    [[ordinates]]
    # Override the 16-point compass direction labels (N through NNW, clockwise).
    # Must supply exactly 16 comma-separated values if overriding.
    # directions = N, NNE, NE, ENE, E, ESE, SE, SSE, S, SSW, SW, WSW, W, WNW, NW, NNW
